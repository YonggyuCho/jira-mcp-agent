# ─────────────────────────────────────────────────────────────
# Atlassian Jira Cloud 접속 정보  (MCP 서버 + 에이전트 공통)
# ─────────────────────────────────────────────────────────────
JIRA_SITE=https://your-site.atlassian.net

# 사이트의 cloud id. 아래에서 확인한다.
#   https://your-site.atlassian.net/_edgeAuth/tenantInfo
JIRA_CLOUD_ID=

JIRA_EMAIL=you@example.com

# https://id.atlassian.com/manage-profile/security/api-tokens 에서 발급
# 필요한 범위: read:jira-work, read:jira-user
JIRA_API_TOKEN=

# scoped(범위 포함) 토큰이면 gateway, 범위 없는 클래식 토큰이면 site.
# auto = 둘 다 시도해서 되는 쪽을 씀 (기본값)
JIRA_AUTH_MODE=auto


# ─────────────────────────────────────────────────────────────
# 일일 취합 에이전트 (agent/)
# MCP 서버만 쓸 거면 아래는 전부 비워둬도 된다.
# ─────────────────────────────────────────────────────────────

# 취합 대상. 둘 다 필수다.
#   AGENT_PROJECT  : Jira 프로젝트 키
#   AGENT_SOLUTION : 커스텀 필드 '솔루션'(cf[12473]) 의 값
AGENT_PROJECT=
AGENT_SOLUTION=
#   AGENT_EPIC     : (선택) 점검 범위를 이 에픽 아래 트리로 한정한다. 솔루션 조건과 AND.
AGENT_EPIC=
#   AGENT_WEB_URL  : (선택) 웹 화면 주소. 넣으면 리포트 끝에 "웹에서 보기" 링크가 붙는다.
AGENT_WEB_URL=
#   WEB_FORM_EXCLUDE_PEOPLE : (선택) 웹 'Jira 등록' 의 담당자·엔지니어·참조 후보에서 뺄 사람. 표시 이름, 쉼표 구분
WEB_FORM_EXCLUDE_PEOPLE=

# 요약용. 없거나 틀려도 리포트는 그대로 발송된다 (요약 한 문단만 빠진다).
ANTHROPIC_API_KEY=

# 발송할 웹훅 주소.
AGENT_WEBHOOK_URL=

# slack | teams | teams-legacy | dooray | raw
#
#   teams        Microsoft Teams — Workflows(Power Automate) 훅. 현재 발급되는 방식.
#                Teams > 채널 > ... > 워크플로 > "웹후크 요청을 받으면 채널에 게시" 에서 만든다.
#                URL 이 https://...logic.azure.com/workflows/... 또는
#                https://...environment.api.powerplatform.com/powerautomate/... 모양이다.
#   teams-legacy 퇴역한 Office 365 커넥터(MessageCard).
#                URL 이 ...webhook.office.com/webhookb2/... 모양. 옛 훅이 남아 있을 때만.
#   slack        Slack 및 호환 훅(Mattermost 등)
#
# 설정과 URL 모양이 어긋나면 URL 쪽을 따르고 경고를 남긴다.
AGENT_WEBHOOK_FORMAT=teams

# 1 이면 발송하지 않고 화면에 출력만 한다. 내용을 확인한 뒤 0 으로 바꾼다.
AGENT_DRY_RUN=1

# 기한이 며칠 남았을 때부터 "임박" 으로 볼지
AGENT_DUE_SOON_DAYS=3

# 요약 모델과 노력 수준. 요약은 짧고 단순해서 low 로 충분하다.
AGENT_MODEL=claude-opus-5
AGENT_EFFORT=low
