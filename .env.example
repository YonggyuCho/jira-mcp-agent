# Atlassian Jira Cloud 접속 정보
JIRA_SITE=https://your-site.atlassian.net
JIRA_CLOUD_ID=<cloud id>
JIRA_EMAIL=you@example.com

# https://id.atlassian.com/manage-profile/security/api-tokens 에서 발급한 토큰
JIRA_API_TOKEN=

# scoped(범위 포함) 토큰이면 gateway, 범위 없는 클래식 토큰이면 site.
# auto = 둘 다 시도해서 되는 쪽을 씀 (기본값)
JIRA_AUTH_MODE=auto
